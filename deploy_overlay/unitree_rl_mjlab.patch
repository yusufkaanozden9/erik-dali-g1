diff --git a/deploy/include/FSM/BaseState.h b/deploy/include/FSM/BaseState.h
index 8d621fe..8d2b9f1 100644
--- a/deploy/include/FSM/BaseState.h
+++ b/deploy/include/FSM/BaseState.h
@@ -30,6 +30,27 @@ public:
     int getState() {return state_; }
     bool isState(int state) { return state_ == state; }
     std::vector<std::pair<std::function<bool()>, int>> registered_checks;
+
+    // Parallel to registered_checks: why each check exists. Upstream logs only
+    // "changed from X to Y", which is ambiguous exactly when it matters — an
+    // operator hitting the e-stop, a comms dropout, the motion running out, and
+    // the policy tripping bad_orientation all land in Passive and print the same
+    // line. Kept as a separate vector rather than widening registered_checks,
+    // whose type every robot's deploy code touches; sites that register without
+    // a label still work and simply report "unlabelled".
+    std::vector<std::string> check_labels;
+
+    void register_check(std::function<bool()> pred, int target_id, std::string label)
+    {
+        check_labels.resize(registered_checks.size());  // pad over unlabelled entries
+        registered_checks.emplace_back(std::move(pred), target_id);
+        check_labels.emplace_back(std::move(label));
+    }
+
+    std::string check_label(size_t i) const
+    {
+        return (i < check_labels.size() && !check_labels[i].empty()) ? check_labels[i] : "unlabelled";
+    }
 private:
     int state_;
 };
