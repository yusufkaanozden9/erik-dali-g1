diff --git a/deploy/robots/g1_23dof/main.cpp b/deploy/robots/g1_23dof/main.cpp
index 286bb3f..74e5583 100644
--- a/deploy/robots/g1_23dof/main.cpp
+++ b/deploy/robots/g1_23dof/main.cpp
@@ -16,7 +16,16 @@ void init_fsm_state()
     {
         spdlog::critical("The other process is using the lowcmd channel, please close it first.");
         unitree::robot::go2::shutdown();
-        // exit(0);
+        // Upstream ships this exit commented out, so the guard logs and then runs
+        // anyway — two controllers end up publishing lowcmd at once, which is the
+        // exact failure unitree_rl_mjlab's own deployment README warns produces
+        // shaking. Seen live on 2026-07-31: the warning fired, the program carried
+        // on regardless, and the operator had no way to tell whether the built-in
+        // controller had actually released the channel. Re-enabled, and with a
+        // non-zero status so a wrapper/service can tell this apart from a clean
+        // shutdown. If this trips: the robot is not in debug mode — press L2+R2
+        // while it is in zero-torque, then start again.
+        exit(1);
     }
     FSMState::lowcmd = std::make_unique<LowCmd_t>();
     FSMState::lowstate = std::make_shared<LowState_t>();
