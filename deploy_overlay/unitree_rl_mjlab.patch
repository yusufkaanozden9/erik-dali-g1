@@ -87,11 +87,13 @@ private:
         
         // Check if need to change state
         int nextStateMode = 0;
+        std::string reason;
         for(int i(0); i<currentState->registered_checks.size(); i++)
         {
             if(currentState->registered_checks[i].first())
             {
                 nextStateMode = currentState->registered_checks[i].second;
+                reason = currentState->check_label(i);
                 break;
             }
         }
@@ -102,7 +104,8 @@ private:
             {
                 if(state->isState(nextStateMode))
                 {
-                    spdlog::info("FSM: Change state from {} to {}", currentState->getStateString(), state->getStateString());
+                    spdlog::info("FSM: Change state from {} to {} [reason: {}]",
+                                 currentState->getStateString(), state->getStateString(), reason);
                     currentState->exit();
                     currentState = state;
                     currentState->enter();
